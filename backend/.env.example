# ==============================================================================
# LIFEOPS AI — BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-app-name.netlify.app

# Database: Supabase PostgreSQL (https://supabase.com)
# Create a free project and run backend/schema.sql in the Supabase SQL Editor
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Primary AI Provider: Groq (https://console.groq.com/keys)
# High-speed LLM inference (Llama 3.3 70B, Qwen 27B, etc.)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Secondary AI Provider: Google Gemini (Optional Fallback from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
