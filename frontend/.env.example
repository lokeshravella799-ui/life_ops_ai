# ==============================================================================
# LIFEOPS AI — FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and configure your production endpoints.
# ==============================================================================

# Backend API URL (Points to your deployed backend service on Render/Railway/Fly.io)
# For local development: http://localhost:5000/api
# For production: https://your-backend-api.onrender.com/api
VITE_API_URL=https://your-backend-api-url.com/api

# Clerk Authentication (Publishable Key from https://dashboard.clerk.com)
# Safe for frontend public exposure
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Supabase (Optional Client-Side Access)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
